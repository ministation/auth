# Discord bot + OAuth
BOT_TOKEN=
API_KEY=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://127.0.0.1:5001/callback
GUILD_ID=
AUTH_DISCORD_ROLE_ID=
REQUIRE_GUILD=true

# Site handoff after Discord auth
SITE_PUBLIC_URL=https://ministation.ru
SITE_LOGIN_PATH=/api/auth/game
GAME_AUTH_SECRET=

# HTTP server
HOST=0.0.0.0
PORT=5001

# Databases: DB1 is required, DB2/DB3/... are optional.
# Link is written to EVERY configured database.
DB1_HOST=localhost
DB1_PORT=5432
DB1_NAME=ss14_db
DB1_USER=ss14_user
DB1_PASSWORD=

