# Discord bot + OAuth
BOT_TOKEN=
API_KEY=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://127.0.0.1:5001/callback
# Auth roles on one or more Discord servers (bot must be on each with Manage Roles).
# Preferred one-liner:
# AUTH_DISCORD_ROLES=1321663704969773086:1359609538659090553,SECOND_GUILD_ID:SECOND_ROLE_ID
GUILD_ID=
AUTH_DISCORD_ROLE_ID=
# Second server (optional; same as adding a second pair to AUTH_DISCORD_ROLES):
# GUILD2_ID=
# AUTH_DISCORD_ROLE_ID_2=
REQUIRE_GUILD=true
# Optional: override which guilds count for REQUIRE_GUILD (comma-separated).
# Default = all guilds from AUTH_DISCORD_ROLES / GUILD_ID / GUILD2_ID (member of any).
# REQUIRE_GUILD_IDS=

# Site handoff after Discord auth (must match token_site GAME_AUTH_SECRET)
SITE_PUBLIC_URL=https://ministation.ru
SITE_LOGIN_PATH=/api/auth/game
GAME_AUTH_SECRET=

# HTTP server
HOST=0.0.0.0
PORT=5001
DISABLE_DOCS=false
RATE_LIMIT_LOGIN=30
RATE_LIMIT_CALLBACK=60
# If true, GET /{user_id} requires ?key=API_KEY (breaks default Corvax check unless game sends key)
REQUIRE_CHECK_API_KEY=false
# Intermediate "Готово" page before redirect to ministation.ru
SHOW_SUCCESS_PAGE=true
# Trust X-Forwarded-For from reverse proxy
TRUST_PROXY=true
FORWARDED_ALLOW_IPS=*

# Databases: DB1 required, DB2/DB3/... optional. Link is written to every DB.
DB1_HOST=localhost
DB1_PORT=5432
DB1_NAME=ss14_db
DB1_USER=ss14_user
DB1_PASSWORD=

# DB2_HOST=localhost
# DB2_PORT=5432
# DB2_NAME=ss14_db_2
# DB2_USER=ss14_user
# DB2_PASSWORD=
