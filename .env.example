# Discord bot + OAuth
BOT_TOKEN=
API_KEY=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://127.0.0.1:5001/callback
# Auth roles on one or more Discord servers.
# Preferred one-liner:
# AUTH_DISCORD_ROLES=MINI_GUILD:MINI_ROLE,OASIS_GUILD:OASIS_ROLE
GUILD_ID=
AUTH_DISCORD_ROLE_ID=
# Second server (Oasis):
# GUILD2_ID=
# AUTH_DISCORD_ROLE_ID_2=
# Separate bot for guild 2 (must be invited to Oasis with Manage Roles).
# Name must be GUILD2_BOT_TOKEN (DISCORD_GUILD2_BOT_TOKEN also accepted):
# GUILD2_BOT_TOKEN=
REQUIRE_GUILD=true
# Which guild(s) user must be in (default: GUILD_ID only):
# REQUIRE_GUILD_IDS=
#
# Backfill already-linked users:
#   python scripts/sync_auth_roles.py --only-guild OASIS_GUILD_ID

# Site handoff after Discord auth (must match token_site GAME_AUTH_SECRET)
SITE_PUBLIC_URL=https://ministation.ru
SITE_LOGIN_PATH=/api/auth/game
GAME_AUTH_SECRET=

# HTTP server
HOST=0.0.0.0
PORT=5001
DISABLE_DOCS=false
RATE_LIMIT_LOGIN=30
RATE_LIMIT_CALLBACK=60
# If true, GET /{user_id} requires ?key=API_KEY (breaks default Corvax check unless game sends key)
REQUIRE_CHECK_API_KEY=false
# Intermediate "Готово" page before redirect to ministation.ru
SHOW_SUCCESS_PAGE=true
# Trust X-Forwarded-For from reverse proxy
TRUST_PROXY=true
FORWARDED_ALLOW_IPS=*

# Онлайн игрового сервера в статусе auth-бота Discord
# (тот же URL, что GAME_STATUS_URL на сайте)
SS14_STATUS_URL=http://ss14.ministation.ru:1214/status
STATUS_UPDATE_INTERVAL_SECONDS=60

# Databases: DB1 required, DB2/DB3/... optional. Link is written to every DB.
DB1_HOST=localhost
DB1_PORT=5432
DB1_NAME=ss14_db
DB1_USER=ss14_user
DB1_PASSWORD=

# DB2_HOST=localhost
# DB2_PORT=5432
# DB2_NAME=ss14_db_2
# DB2_USER=ss14_user
# DB2_PASSWORD=
